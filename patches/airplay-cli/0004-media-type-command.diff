Modified by DualPod, 2026-11: a MEDIATYPE command (music or video) and CLIAIRPLAY_MEDIA_TYPE, so declaring video turns a HomePod's Sound Glow off during playback.

diff --git a/src/ap2_mrp.c b/src/ap2_mrp.c
index de6563a..d4edaca 100644
--- a/src/ap2_mrp.c
+++ b/src/ap2_mrp.c
@@ -1869,6 +1869,26 @@ int ap2_mrp_event_status(struct ap2_mrp_ctx *m)
     return atomic_load(&m->event_connected) ? 1 : 0;
 }
 
+/* The media type the now-playing push declares: music (the default) or
+ * video. A HomePod's Sound Glow stays off while video plays, so declaring
+ * video darkens the light during playback without touching the audio.
+ * One process drives one receiver, so this is process-wide. */
+static atomic_bool g_np_video = false;
+
+bool ap2_mrp_set_media_type(const char *type)
+{
+    if (!type) return false;
+    if (strcmp(type, "music") == 0) atomic_store(&g_np_video, false);
+    else if (strcmp(type, "video") == 0) atomic_store(&g_np_video, true);
+    else return false;
+    return true;
+}
+
+bool ap2_mrp_media_type_is_video(void)
+{
+    return atomic_load(&g_np_video);
+}
+
 bool ap2_mrp_build_nowplaying_command(struct ap2_mrp_ctx *m,
                                       uint8_t **out, int *out_len)
 {
@@ -1904,8 +1924,16 @@ bool ap2_mrp_build_nowplaying_command(struct ap2_mrp_ctx *m,
     ap2_pl_dict_set(info, "kMRMediaRemoteNowPlayingInfoTimestamp",
                     ap2_pl_date(m->elapsed_set_at > 0.0 ? m->elapsed_set_at
                                                         : mrp_cf_now()));
-    ap2_pl_dict_set(info, "kMRMediaRemoteNowPlayingInfoMediaType",
-                    ap2_pl_string("MRMediaRemoteMediaTypeMusic"));
+    if (atomic_load(&g_np_video)) {
+        /* The keys and values an iPhone sends, with "video" for "audio". */
+        ap2_pl_dict_set(info, "kMRMediaRemoteNowPlayingInfoMediaType",
+                        ap2_pl_string("kMRMediaRemoteNowPlayingInfoTypeVideo"));
+        ap2_pl_dict_set(info, "kMRMediaRemoteNowPlayingInfoStrictMediaType",
+                        ap2_pl_string("video"));
+    } else {
+        ap2_pl_dict_set(info, "kMRMediaRemoteNowPlayingInfoMediaType",
+                        ap2_pl_string("MRMediaRemoteMediaTypeMusic"));
+    }
     ap2_pl_dict_set(info, "kMRMediaRemoteNowPlayingInfoUniqueIdentifier",
                     ap2_pl_int((int64_t)m->np_uid));
     if (m->artwork && m->artwork_len > 0) {
