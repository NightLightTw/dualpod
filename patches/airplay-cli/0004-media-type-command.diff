diff --git a/tests/test_ap2_event.c b/tests/test_ap2_event.c
index 1b66ce1..19c9a4f 100644
--- a/tests/test_ap2_event.c
+++ b/tests/test_ap2_event.c
@@ -280,6 +280,46 @@ static bool contains_bytes(const uint8_t *haystack, int haystack_len,
     return false;
 }
 
+static bool snapshot_has(struct ap2_mrp_ctx *mrp, const char *text)
+{
+    uint8_t *snap = NULL;
+    int len = 0;
+    assert(ap2_mrp_build_nowplaying_command(mrp, &snap, &len));
+    bool found = contains_bytes(snap, len, (const uint8_t *)text, (int)strlen(text));
+    free(snap);
+    return found;
+}
+
+/* MEDIATYPE: music is the default and unchanged; video swaps in the iPhone's
+ * video keys; anything else is refused and leaves the current type. */
+static void test_media_type(const uint8_t secret[KEY_SIZE])
+{
+    struct ap2_mrp_ctx *mrp = ap2_mrp_create(
+        "127.0.0.1", 7000, NULL, "1A2B3D4EA1B2C3D4",
+        "Music Assistant", "11111111-2222-4333-8444-5555555555ab",
+        "aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee", secret, KEY_SIZE);
+    assert(mrp);
+    assert(!ap2_mrp_media_type_is_video());
+    assert(snapshot_has(mrp, "MRMediaRemoteMediaTypeMusic"));
+    assert(!snapshot_has(mrp, "StrictMediaType"));
+
+    assert(ap2_mrp_set_media_type("video"));
+    assert(ap2_mrp_media_type_is_video());
+    assert(snapshot_has(mrp, "kMRMediaRemoteNowPlayingInfoTypeVideo"));
+    assert(snapshot_has(mrp, "kMRMediaRemoteNowPlayingInfoStrictMediaType"));
+    assert(!snapshot_has(mrp, "MRMediaRemoteMediaTypeMusic"));
+
+    assert(!ap2_mrp_set_media_type("Video"));
+    assert(!ap2_mrp_set_media_type(""));
+    assert(!ap2_mrp_set_media_type(NULL));
+    assert(ap2_mrp_media_type_is_video());
+
+    assert(ap2_mrp_set_media_type("music"));
+    assert(snapshot_has(mrp, "MRMediaRemoteMediaTypeMusic"));
+    assert(!snapshot_has(mrp, "StrictMediaType"));
+    ap2_mrp_destroy(mrp);
+}
+
