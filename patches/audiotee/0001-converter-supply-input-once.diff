     let status = avConverter.convert(to: outputBuffer, error: &error) {
       requestedPackets, outStatus in
+      if supplied {
+        outStatus.pointee = .noDataNow
+        return nil
+      }
+      supplied = true
       outStatus.pointee = .haveData
       return inputBuffer
     }
