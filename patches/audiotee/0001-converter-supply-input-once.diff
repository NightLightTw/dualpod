     // across chunks (avoiding discontinuity artifacts).
     var error: NSError?
 
+    // 這一塊只能交出去一次：重採樣器為了往前看會再要資料，原版每次都回同一塊，
+    // 等於每 20 ms 把一小段重播一次，音樂聽起來就有一層「呲呲」雜訊
